# Product
PRODUCT_NAME=Sahayak

# Environment
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sahayak.db
DATABASE_ECHO=false

# File storage
DATA_DIR=./data
MODELS_DIR=./models
MAX_UPLOAD_SIZE=10485760
MAX_WS_MESSAGE_SIZE=4194304

# ML Engine
USE_MOCK_ENGINES=true
VAD_MODEL_PATH=models/silero_vad.onnx
ASR_MODEL_PATH=models/whisper_tiny.onnx
SUMMARIZER_MODEL_PATH=
ENABLE_GENAI_SUMMARIZER=false

# Provider selection (ordered by preference)
PREFERRED_PROVIDERS=QNNExecutionProvider,CUDAExecutionProvider,DmlExecutionProvider,CPUExecutionProvider

# Benchmark
BENCHMARK_AUDIO_PATH=scripts/benchmark_audio.wav
BENCHMARK_ITERATIONS=3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json